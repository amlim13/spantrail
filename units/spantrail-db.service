[Unit]
Description=SpanTrail PostgreSQL database
After=network.target

[Service]
Type=notify
User=spantrail
Group=spantrail
Slice=spantrail.slice
EnvironmentFile=/opt/spantrail/app/.env
WorkingDirectory=/opt/spantrail/pgdata
ExecStart=/usr/lib/postgresql/16/bin/postgres -D /opt/spantrail/pgdata
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGINT

# Hard resource caps - the kernel OOM killer will only ever target this cgroup.
MemoryHigh=640M
MemoryMax=768M
MemorySwapMax=0
CPUQuota=20%
TasksMax=200
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/spantrail/pgdata /opt/spantrail/app
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
