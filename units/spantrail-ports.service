[Unit]
Description=SpanTrail privileged port forwarder (:80 and :443 -> Caddy :8443)
Documentation=https://caddyserver.com/docs/handbook/reverse-proxy
After=network.target
Before=spantrail-web.service

[Service]
Type=simple
User=root
Group=root
# -n 2 : run two processes, one per port
# -q    : quiet
# -b    : bind address
ExecStart=/usr/bin/socat -n 2 TCP-LISTEN:80,fork,reuseaddr,bind=0.0.0.0 TCP:127.0.0.1:8443
ExecStart=/usr/bin/socat -n 2 TCP-LISTEN:443,fork,reuseaddr,bind=0.0.0.0 TCP:127.0.0.1:8443
Restart=always
RestartSec=3

# Minimal: this unit only forwards sockets. It must stay tiny and boring.
MemoryHigh=48M
MemoryMax=64M
MemorySwapMax=0
CPUQuota=5%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
