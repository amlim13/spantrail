{
	admin off
	email ops@spantrail.com
}

# Public edge. Caddy runs as the unprivileged `spantrail` user and cannot bind
# :80/:443 itself, so a root-owned port forwarder (spantrail-ports.service)
# listens on those ports and proxies to Caddy on :8443.
#
# The :8443 block below is the real site. `spantrail.com` and `www.spantrail.com`
# get a real Let's Encrypt certificate via ACME once DNS points at this host.

:8443 {
	tls /opt/spantrail/caddy/tls/spantrail.crt /opt/spantrail/caddy/tls/spantrail.key
	encode zstd gzip

	# Serve the pinned cert so SDK clients can verify instead of skipping TLS.
	handle /ca.crt {
		root * /opt/spantrail/caddy
		rewrite * /tls/spantrail.crt
		file_server
	}

	handle /health {
		reverse_proxy 127.0.0.1:8080
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /dashboard {
		root * /opt/spantrail/www
		rewrite * /dashboard.html
		file_server
	}

	handle /dashboard/* {
		root * /opt/spantrail/www
		rewrite * /dashboard.html
		file_server
	}

	# Downloadable SDK wheel.
	handle /dist/* {
		root * /opt/spantrail
		rewrite * /{uri}
		header Content-Type application/octet-stream
		file_server
	}

	handle {
		root * /opt/spantrail/www
		try_files {path} /index.html
		file_server
	}
}
