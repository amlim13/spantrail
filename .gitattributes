# Normalize line endings: the repo is checked out on Windows, Linux and macOS.
* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.service text eol=lf
*.slice text eol=lf
*.timer text eol=lf
Caddyfile text eol=lf

*.png binary
*.jpg binary
*.whl binary
*.tar.gz binary
